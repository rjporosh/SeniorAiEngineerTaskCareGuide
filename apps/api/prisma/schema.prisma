generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")
  role          String
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  documents     Document[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("refresh_tokens")
}

model Document {
  id               String   @id @default(uuid()) @db.Uuid
  ownerId          String   @map("owner_id") @db.Uuid
  originalFilename String   @map("original_filename")
  detectedMime     String   @map("detected_mime")
  byteSize         BigInt   @map("byte_size")
  sha256           String
  storageKey       String   @unique @map("storage_key")
  storageProvider  String   @map("storage_provider")
  documentType     String   @default("unknown") @map("document_type")
  processingStatus String   @default("queued") @map("processing_status")
  reviewStatus     String   @default("not_required") @map("review_status")
  failureCode      String?  @map("failure_code")
  failureMessage   String?  @map("failure_message")
  idempotencyKey   String?  @map("idempotency_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner       User               @relation(fields: [ownerId], references: [id])
  attempts    ProcessingAttempt[]
  results     ExtractedResult[]
  issues      ValidationIssue[]
  chunks      TextChunk[]
  corrections Correction[]
  audits      AuditEvent[]

  @@unique([ownerId, idempotencyKey])
  @@index([processingStatus, createdAt])
  @@index([ownerId, createdAt])
  @@index([sha256])
  @@map("documents")
}

model ProcessingAttempt {
  id            String    @id @default(uuid()) @db.Uuid
  documentId    String    @map("document_id") @db.Uuid
  attemptNumber Int       @map("attempt_number")
  stage         String
  status        String
  errorCode     String?   @map("error_code")
  errorMessage  String?   @map("error_message")
  retryable     Boolean   @default(false)
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, attemptNumber])
  @@map("processing_attempts")
}

model ExtractedResult {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  isCurrent        Boolean  @default(true) @map("is_current")
  schemaVersion    String   @map("schema_version")
  invoiceNumber    String?  @map("invoice_number")
  invoiceNumberKey String?  @map("invoice_number_key")
  invoiceDate      String?  @map("invoice_date")
  supplierName     String?  @map("supplier_name")
  supplierKey      String?  @map("supplier_key")
  customerName     String?  @map("customer_name")
  totalAmount      Decimal? @map("total_amount") @db.Decimal(20, 4)
  currency         String?
  raw              Json
  current          Json
  extractor        Json
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  document         Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, isCurrent])
  @@index([invoiceNumberKey, supplierKey])
  @@index([supplierName])
  @@index([invoiceDate])
  @@map("extracted_results")
}

model ValidationIssue {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  code       String
  severity   String
  message    String
  fields     String[]
  details    Json
  resolution String   @default("open")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("validation_issues")
}

model TextChunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  chunkIndex Int      @map("chunk_index")
  page       Int?
  sheet      String?
  range      String?
  content    String
  embedding  Unsupported("vector(256)")?
  tsv        Unsupported("tsvector")?
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
  @@map("text_chunks")
}

model Correction {
  id             String   @id @default(uuid()) @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  resultId       String   @map("result_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  fieldPath      String   @map("field_path")
  previousValue  Json?    @map("previous_value")
  correctedValue Json?    @map("corrected_value")
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  document       Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("corrections")
}

model AuditEvent {
  id         String    @id @default(uuid()) @db.Uuid
  documentId String?   @map("document_id") @db.Uuid
  actorId    String?   @map("actor_id") @db.Uuid
  eventType  String    @map("event_type")
  metadata   Json
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("audit_events")
}

model OutboxMessage {
  id          String    @id @default(uuid()) @db.Uuid
  topic       String
  payload     Json
  status      String    @default("pending")
  attempts    Int       @default(0)
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt      DateTime? @map("sent_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_messages")
}

{
  "title": "Document Intelligence - Overview",
  "uid": "docint-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "HTTP requests / s by status", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(http_requests_total[1m]))", "legendFormat": "{{status}}" }] },
    { "id": 2, "type": "timeseries", "title": "HTTP p95 latency (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}" }] },
    { "id": 3, "type": "timeseries", "title": "Documents processed / min", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (outcome) (increase(documents_processed_total[1m]))", "legendFormat": "{{outcome}}" }] },
    { "id": 4, "type": "timeseries", "title": "Processing time p95 (s)", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(document_processing_duration_seconds_bucket[5m])))", "legendFormat": "{{kind}}" }] },
    { "id": 5, "type": "stat", "title": "Queue: ready / dead-lettered", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "queue_messages", "legendFormat": "{{state}}" }] },
    { "id": 6, "type": "timeseries", "title": "API memory (RSS)", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "rss" }] }
  ]
}

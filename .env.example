# Copy to .env and replace every CHANGE_ME value. Never commit .env.
NODE_ENV=production
APP_ENV=local
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- Providers (switch without code changes) ---
# DATABASE_PROVIDER: postgres | mongodb | memory (memory is tests/dev only)
DATABASE_PROVIDER=postgres
# QUEUE_PROVIDER: rabbitmq | bullmq
QUEUE_PROVIDER=rabbitmq
# OBJECT_STORAGE_PROVIDER: minio | local
OBJECT_STORAGE_PROVIDER=minio

# --- PostgreSQL ---
POSTGRES_USER=docint
POSTGRES_PASSWORD=CHANGE_ME_postgres
POSTGRES_DB=docint
DATABASE_URL=postgresql://docint:CHANGE_ME_postgres@postgres:5432/docint

# --- MongoDB (compose profile: mongodb) ---
MONGODB_URI=mongodb://mongo:27017/docint

# --- RabbitMQ ---
RABBITMQ_DEFAULT_USER=docint
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbit
RABBITMQ_URL=amqp://docint:CHANGE_ME_rabbit@rabbitmq:5672

# --- Redis / BullMQ (compose profile: bullmq) ---
REDIS_URL=redis://redis:6379

# --- Object storage ---
STORAGE_LOCAL_ROOT=/data/storage
MINIO_ROOT_USER=docint
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_min8chars
S3_ENDPOINT=http://minio:9000
S3_BUCKET=documents
S3_REGION=us-east-1
S3_ACCESS_KEY=docint
S3_SECRET_KEY=CHANGE_ME_minio_min8chars

# --- Internal services and auth (generate with: openssl rand -hex 32) ---
PROCESSOR_BASE_URL=http://processor:8000
PROCESSOR_SERVICE_TOKEN=CHANGE_ME_service_token_16plus
JWT_ACCESS_SECRET=CHANGE_ME_jwt_secret_at_least_32_characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- Limits ---
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE_MB=200
MAX_FILES_PER_BATCH=20
MAX_PDF_PAGES=1000
MAX_IMAGE_PIXELS=60000000
MAX_SPREADSHEET_ROWS=200000
PROCESSING_TIMEOUT_SECONDS=900

# Host port for the API (avoids clashes with other local stacks)
API_PUBLIC_PORT=4000

{
  "name": "document-intelligence",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter '!@docint/e2e' build",
    "typecheck": "pnpm -r --filter '!@docint/e2e' typecheck",
    "lint": "pnpm -r --filter '!@docint/e2e' lint",
    "test": "pnpm -r --filter '!@docint/e2e' test",
    "test:e2e": "pnpm --filter @docint/e2e test",
    "test:integration": "./scripts/test-integration.sh"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
